# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. Never commit .env.local.
# All limits are configuration, never hardcoded in the codebase (spec section 48).
# ---------------------------------------------------------------------------

# --- Supabase -------------------------------------------------------------
# Public: safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Server only. NEVER prefix with NEXT_PUBLIC_ — this key bypasses row-level
# security and must never reach the client bundle.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- AI -------------------------------------------------------------------
# Server only (spec section 47).
ANTHROPIC_API_KEY="sk-ant-..."

# Model routing. See docs/AI.md section 4.
MODEL_EXTRACTION="claude-opus-5"
MODEL_CLASSIFICATION="claude-haiku-4-5"

# --- Limits and cost protection (spec section 48) -------------------------
# Bytes. 5 MB default.
MAX_RESUME_SIZE_BYTES="5242880"
# Characters of raw JD text accepted at the API boundary.
MAX_JD_LENGTH="20000"
# TOKEN budget for any single model call, measured with countTokens() before
# sending — not String.length. See docs/AI.md section 1.
MAX_TEXT_TOKENS="12000"
MAX_OUTPUT_TOKENS="8000"
MAX_AI_RETRIES="2"
MAX_ANALYSES_PER_DAY_ANONYMOUS="2"
MAX_ANALYSES_PER_DAY_AUTHENTICATED="20"

# --- Retention (spec section 45) ------------------------------------------
# Days before the raw uploaded file is deleted. Structured analysis persists.
RETENTION_DAYS="7"
